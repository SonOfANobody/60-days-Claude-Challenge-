<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>🦈 AI Shark Tank Simulator</title>
<style>
:root{
  --dark:#0a0e27;
  --darker:#050810;
  --card:#1a1f3a;
  --card-light:#242b4a;
  --accent:#00d4ff;
  --accent-dark:#0099cc;
  --good:#00ff41;
  --warn:#ffaa00;
  --danger:#ff3366;
  --text:#e8ecf1;
  --text-dim:#8892a6;
  --mono:'IBM Plex Mono','SF Mono',Consolas,monospace;
  --sans:'Inter',-apple-system,'Segoe UI',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:var(--dark);color:var(--text);font-family:var(--sans);overflow-x:hidden}
body{min-height:100vh;background:linear-gradient(135deg,#0a0e27 0%,#0f1535 100%);scroll-behavior:smooth}
::selection{background:var(--accent-dark);color:#000}

.shell{max-width:1280px;margin:0 auto;padding:0 20px}

/* ───── TOPBAR ───── */
.topbar{
  position:sticky;top:0;z-index:100;
  background:rgba(10,14,39,.95);backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(0,212,255,.15);
  padding:14px 0;
  margin-bottom:24px;
}
.topbar-inner{display:flex;justify-content:space-between;align-items:center}
.brand{font-size:18px;font-weight:800;letter-spacing:-0.5px}
.brand-shark{color:var(--accent);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.topbar-nav{display:flex;gap:20px;align-items:center}
.nav-link{font-size:13px;color:var(--text-dim);cursor:pointer;transition:.2s}
.nav-link:hover{color:var(--accent)}
.nav-link.active{color:var(--accent);font-weight:700}

/* ───── SCREENS ───── */
.screen{display:none;animation:fadeIn .3s ease}
.screen.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

.hero{text-align:center;padding:40px 0;margin-bottom:40px}
.hero h1{font-size:clamp(28px,5vw,48px);font-weight:900;margin-bottom:12px;letter-spacing:-1px}
.hero p{font-size:15px;color:var(--text-dim);max-width:600px;margin:0 auto;line-height:1.6}

/* ───── FORM INPUTS ───── */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:24px}
.form-col{display:flex;flex-direction:column;gap:18px}
.form-col.full{grid-column:1/-1}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group label{font-size:12px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.04em}
.form-group input,
.form-group textarea{
  background:rgba(255,255,255,.06);
  border:1px solid rgba(0,212,255,.2);
  border-radius:8px;
  padding:12px 14px;
  color:var(--text);
  font-family:inherit;
  font-size:13px;
  transition:border-color .2s, box-shadow .2s;
}
.form-group input:focus,
.form-group textarea:focus{
  outline:none;
  border-color:var(--accent);
  box-shadow:0 0 12px rgba(0,212,255,.2);
}
.form-group textarea{resize:vertical;min-height:80px}

/* ───── BUTTONS ───── */
.btn{
  padding:12px 28px;
  border:none;
  border-radius:6px;
  font-weight:700;
  font-size:13px;
  cursor:pointer;
  transition:all .2s;
  font-family:inherit;
  letter-spacing:.02em;
  text-transform:uppercase;
}
.btn-primary{background:var(--accent);color:#000}
.btn-primary:hover{background:#00e6ff;box-shadow:0 0 20px rgba(0,212,255,.4)}
.btn-secondary{background:rgba(0,212,255,.15);color:var(--accent);border:1px solid var(--accent)}
.btn-secondary:hover{background:rgba(0,212,255,.25)}
.btn-ghost{background:transparent;color:var(--text-dim);border:1px solid var(--text-dim)}
.btn-ghost:hover{color:var(--accent);border-color:var(--accent)}
.btn-danger{background:var(--danger);color:#fff}
.btn-danger:hover{background:#ff5580}
.btn-row{display:flex;gap:12px;flex-wrap:wrap}

/* ───── PITCH CARD ───── */
.pitch-card{
  background:linear-gradient(135deg,var(--card) 0%,var(--card-light) 100%);
  border:1px solid rgba(0,212,255,.15);
  border-radius:12px;
  padding:28px;
  margin-bottom:24px;
  position:relative;
  overflow:hidden;
}
.pitch-card::before{
  content:'';position:absolute;top:-50%;right:-50%;width:300px;height:300px;
  background:radial-gradient(circle,rgba(0,212,255,.06),transparent 70%);
  border-radius:50%;
}
.pitch-card > *{position:relative;z-index:1}
.pitch-card h2{font-size:24px;margin-bottom:16px;color:var(--accent)}
.pitch-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.pitch-item{display:flex;flex-direction:column;gap:4px}
.pitch-item label{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em}
.pitch-item value{font-size:15px;font-weight:700;color:var(--text)}

/* ───── JUDGE CARDS ───── */
.judges-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:32px}
.judge-card{
  background:var(--card);border:1px solid rgba(0,212,255,.15);border-radius:10px;
  padding:18px;text-align:center;transition:transform .2s, border-color .2s, box-shadow .2s;
}
.judge-card:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 8px 24px rgba(0,212,255,.15)}
.judge-emoji{font-size:32px;margin-bottom:8px}
.judge-name{font-weight:700;font-size:12px;margin-bottom:4px}
.judge-focus{font-size:10px;color:var(--text-dim);line-height:1.4}
.judge-score{
  margin-top:12px;font-family:var(--mono);
  font-weight:700;font-size:14px;
  color:var(--accent);
}

/* ───── Q&A SECTION ───── */
.qa-section{margin-bottom:32px}
.qa-section h3{font-size:14px;font-weight:700;color:var(--accent);margin-bottom:16px}
.question-card{
  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
  border-radius:8px;padding:16px;margin-bottom:14px;
}
.q-judge{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:12px}
.q-judge-emoji{font-size:16px}
.q-judge-name{font-weight:700;color:var(--accent)}
.q-text{font-size:13px;color:var(--text);margin-bottom:12px;line-height:1.5}
.answer-input{
  background:rgba(0,212,255,.06);border:1px solid rgba(0,212,255,.2);
  border-radius:6px;padding:10px 12px;color:var(--text);font-family:inherit;
  font-size:12px;width:100%;
}
.answer-input:focus{outline:none;border-color:var(--accent)}
.q-row{display:flex;gap:8px;margin-top:10px}
.q-row .btn{flex:1}

/* ───── DECISION CARD ───── */
.decision-card{
  background:linear-gradient(135deg,var(--card) 0%,var(--card-light) 100%);
  border:2px solid;border-radius:14px;padding:32px;text-align:center;margin:32px 0;
}
.decision-card.invest{border-color:var(--good);background:linear-gradient(135deg,rgba(0,255,65,.1),rgba(0,255,65,.05))}
.decision-card.reject{border-color:var(--danger);background:linear-gradient(135deg,rgba(255,51,102,.1),rgba(255,51,102,.05))}
.decision-card.acquire{border-color:var(--warn);background:linear-gradient(135deg,rgba(255,170,0,.1),rgba(255,170,0,.05))}
.decision-card.later{border-color:var(--accent);background:linear-gradient(135deg,rgba(0,212,255,.1),rgba(0,212,255,.05))}
.decision-emoji{font-size:48px;margin-bottom:12px}
.decision-title{font-size:28px;font-weight:900;margin-bottom:16px;letter-spacing:-0.5px}
.decision-title.invest{color:var(--good)}
.decision-title.reject{color:var(--danger)}
.decision-title.acquire{color:var(--warn)}
.decision-title.later{color:var(--accent)}
.decision-details{font-size:13px;color:var(--text-dim);margin-bottom:12px;line-height:1.7}
.decision-reasoning{
  background:rgba(255,255,255,.04);border-left:3px solid;border-radius:4px;
  padding:14px 16px;text-align:left;font-size:12px;margin:18px 0;line-height:1.6;
}
.decision-reasoning.invest{border-color:var(--good);color:var(--good)}
.decision-reasoning.reject{border-color:var(--danger);color:var(--danger)}
.decision-reasoning.acquire{border-color:var(--warn);color:var(--warn)}
.decision-reasoning.later{border-color:var(--accent);color:var(--accent)}

/* ───── SCORES ───── */
.scores-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:24px 0}
.score-box{
  background:rgba(255,255,255,.04);border:1px solid rgba(0,212,255,.15);
  border-radius:8px;padding:14px;text-align:center;
}
.score-label{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
.score-value{font-family:var(--mono);font-size:24px;font-weight:800;color:var(--accent)}
.score-bar{
  background:rgba(255,255,255,.06);height:4px;border-radius:2px;margin-top:8px;overflow:hidden;
}
.score-fill{height:100%;background:var(--accent);border-radius:2px;transition:width 1s ease}

/* ───── LEADERBOARD ───── */
.leaderboard-table{
  width:100%;border-collapse:collapse;
  margin:20px 0;
}
.leaderboard-table th{
  background:rgba(0,212,255,.1);padding:12px;text-align:left;font-size:11px;
  font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.04em;
  border-bottom:1px solid rgba(0,212,255,.2);
}
.leaderboard-table td{
  padding:12px;border-bottom:1px solid rgba(255,255,255,.05);font-size:12px;
}
.leaderboard-table tr:hover{background:rgba(0,212,255,.05)}
.rank-medal{font-size:16px;margin-right:6px}

/* ───── CONFETTI ───── */
.confetti{
  position:fixed;pointer-events:none;
  width:10px;height:10px;
  animation:fall 3s linear forwards;
}
@keyframes fall{
  to{transform:translateY(100vh) rotate(360deg);opacity:0}
}

/* ───── RESPONSIVE ───── */
@media(max-width:880px){
  .judges-grid{grid-template-columns:repeat(2,1fr)}
  .form-grid{grid-template-columns:1fr}
  .pitch-row{grid-template-columns:1fr}
  .scores-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:560px){
  .judges-grid{grid-template-columns:1fr}
  .scores-grid{grid-template-columns:repeat(2,1fr)}
  .btn-row{flex-direction:column}
  .btn{width:100%}
}
</style>
</head>
<body>

<div class="topbar">
  <div class="shell">
    <div class="topbar-inner">
      <div class="brand"><span class="brand-shark">🦈</span> SHARK TANK SIMULATOR</div>
      <div class="topbar-nav">
        <div class="nav-link active" data-screen="pitch">Pitch</div>
        <div class="nav-link" data-screen="leaderboard">Leaderboard</div>
        <div class="nav-link" data-screen="about">About</div>
      </div>
    </div>
  </div>
</div>

<div class="shell">

  <!-- ═════════════ PITCH SCREEN ═════════════ -->
  <div class="screen active" id="screen-pitch">

    <!-- Input Phase -->
    <div id="phase-input" class="phase-input">
      <div class="hero">
        <h1>Pitch Your Startup</h1>
        <p>Get real feedback from 4 AI judges. Answer their toughest questions. Find out if you'll get funded.</p>
      </div>

      <div style="max-width:800px;margin:0 auto">
        <div class="form-grid">
          <div class="form-group">
            <label>Startup Name</label>
            <input type="text" id="startup-name" placeholder="e.g. NeuroStrat Labs">
          </div>
          <div class="form-group">
            <label>Funding Ask (USD)</label>
            <input type="number" id="funding-ask" placeholder="e.g. 250000" min="0">
          </div>
          <div class="form-group form-col full">
            <label>Problem Statement</label>
            <textarea id="problem" placeholder="What problem are you solving?"></textarea>
          </div>
          <div class="form-group form-col full">
            <label>Your Solution</label>
            <textarea id="solution" placeholder="How does your startup solve it?"></textarea>
          </div>
          <div class="form-group">
            <label>Revenue Model</label>
            <input type="text" id="revenue-model" placeholder="e.g. SaaS subscription, one-time license">
          </div>
          <div class="form-group">
            <label>Target Audience</label>
            <input type="text" id="target-audience" placeholder="e.g. mid-market enterprises">
          </div>
        </div>

        <div class="btn-row">
          <button class="btn btn-primary" onclick="startPitch()" style="flex:1">🎤 Go to Shark Tank</button>
        </div>
      </div>
    </div>

    <!-- Pitch Phase -->
    <div id="phase-pitch" class="phase-pitch" style="display:none">
      <div class="pitch-card" id="pitch-display"></div>

      <div class="judges-grid" id="judges-display"></div>

      <div id="qa-container"></div>

      <div class="btn-row" style="justify-content:center">
        <button class="btn btn-secondary" onclick="finishPitch()">See Decision</button>
      </div>
    </div>

    <!-- Decision Phase -->
    <div id="phase-decision" class="phase-decision" style="display:none">
      <div id="decision-display"></div>

      <div class="scores-grid" id="scores-display"></div>

      <div class="btn-row" style="justify-content:center">
        <button class="btn btn-primary" onclick="downloadReport()">📊 Download Report</button>
        <button class="btn btn-secondary" onclick="shareResult()">🔗 Share Result</button>
        <button class="btn btn-ghost" onclick="resetPitch()">🔄 New Pitch</button>
      </div>
    </div>

  </div>

  <!-- ═════════════ LEADERBOARD SCREEN ═════════════ -->
  <div class="screen" id="screen-leaderboard">
    <div class="hero">
      <h1>Leaderboard</h1>
      <p>Top-funded startups from AI Shark Tank</p>
    </div>
    <table class="leaderboard-table" id="leaderboard-table">
      <thead>
        <tr><th></th><th>Startup</th><th>Funding Ask</th><th>Decision</th><th>Valuation</th></tr>
      </thead>
      <tbody id="leaderboard-body"></tbody>
    </table>
    <p style="text-align:center;color:var(--text-dim);margin-top:20px">Your pitches will appear here once evaluated.</p>
  </div>

  <!-- ═════════════ ABOUT SCREEN ═════════════ -->
  <div class="screen" id="screen-about">
    <div class="hero">
      <h1>About AI Shark Tank</h1>
      <p>An interactive simulator powered by Claude AI</p>
    </div>
    <div style="max-width:800px;margin:0 auto;background:var(--card);border:1px solid rgba(0,212,255,.15);border-radius:12px;padding:28px;line-height:1.7;color:var(--text-dim)">
      <p style="margin-bottom:14px">This simulator uses Claude AI to evaluate your startup pitch across 4 distinct investor personas:</p>
      <p style="margin-bottom:14px"><strong style="color:var(--accent)">🦈 Venture Capitalist</strong> — Focuses on market size, scalability, and total addressable market (TAM).</p>
      <p style="margin-bottom:14px"><strong style="color:var(--accent)">🦈 Founder</strong> — Focuses on team execution, product-market fit, and go-to-market capability.</p>
      <p style="margin-bottom:14px"><strong style="color:var(--accent)">🦈 Customer</strong> — Focuses on user value, problem severity, and actual willingness to pay.</p>
      <p style="margin-bottom:14px"><strong style="color:var(--accent)">🦈 Angel Investor</strong> — Focuses on unit economics, margin potential, and cash flow sustainability.</p>
      <p>Answer each judge's tough questions honestly. Your responses feed into their investment decision. Get funded, come back later, or get an acquisition offer!</p>
    </div>
  </div>

</div>

<script>
const state = {
  startup: null,
  judges: null,
  answers: {},
  decision: null,
  scores: null,
  leaderboard: JSON.parse(localStorage.getItem('shark-tank-lb') || '[]'),
};

// Navigation
document.querySelectorAll('.nav-link').forEach(link => {
  link.addEventListener('click', e => {
    const screen = e.target.dataset.screen;
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById('screen-' + screen).classList.add('active');
    document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
    e.target.classList.add('active');
    if(screen === 'leaderboard') renderLeaderboard();
  });
});

async function startPitch(){
  const startup = {
    name: document.getElementById('startup-name').value.trim(),
    problem: document.getElementById('problem').value.trim(),
    solution: document.getElementById('solution').value.trim(),
    revenueModel: document.getElementById('revenue-model').value.trim(),
    targetAudience: document.getElementById('target-audience').value.trim(),
    fundingAsk: parseInt(document.getElementById('funding-ask').value) || 0,
  };

  if(!startup.name || !startup.problem || !startup.solution){
    alert('Please fill in Startup Name, Problem, and Solution');
    return;
  }

  state.startup = startup;
  document.getElementById('phase-input').style.display = 'none';
  document.getElementById('phase-pitch').style.display = 'block';

  renderPitch();
  await generateJudges();
}

function renderPitch(){
  const p = state.startup;
  const html = `
    <h2>${p.name}</h2>
    <div class="pitch-row">
      <div class="pitch-item"><label>Problem</label><value>${p.problem}</value></div>
      <div class="pitch-item"><label>Solution</label><value>${p.solution}</value></div>
    </div>
    <div class="pitch-row">
      <div class="pitch-item"><label>Revenue Model</label><value>${p.revenueModel}</value></div>
      <div class="pitch-item"><label>Target Audience</label><value>${p.targetAudience}</value></div>
    </div>
    <div class="pitch-item" style="grid-column:1/-1"><label>Funding Ask</label><value>$${p.fundingAsk.toLocaleString()}</value></div>
  `;
  document.getElementById('pitch-display').innerHTML = html;
}

async function generateJudges(){
  const judges = [
    { emoji: '🦈', name: 'Venture Capitalist', focus: 'Market size and scalability', key: 'vc' },
    { emoji: '🦈', name: 'Founder', focus: 'Execution capability', key: 'founder' },
    { emoji: '🦈', name: 'Customer', focus: 'Usefulness and value', key: 'customer' },
    { emoji: '🦈', name: 'Angel Investor', focus: 'Profitability and margins', key: 'angel' },
  ];

  const judgeSummary = judges.map(j => `${j.name}: ${j.focus}`).join('\n');

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1200,
        system: `You are a Shark Tank judge providing tough, realistic investor feedback. You will be given startup details and asked to generate questions from each judge's perspective. Be specific, direct, and thoughtful.`,
        messages: [{
          role: 'user',
          content: `Startup: ${state.startup.name}\nProblem: ${state.startup.problem}\nSolution: ${state.startup.solution}\nRevenue Model: ${state.startup.revenueModel}\nFunding Ask: $${state.startup.fundingAsk}\n\nGenerate 2 tough, specific questions from each of these 4 judge perspectives:\n\n${judgeSummary}\n\nFormat your response as JSON with a judges array. Each judge should have: name, key (vc/founder/customer/angel), question1, question2.`,
        }],
      }),
    });

    const data = await response.json();
    let content = data.content[0].text;
    content = content.replace(/```json|```/g, '').trim();
    const judgesData = JSON.parse(content);

    state.judges = judges.map(j => {
      const judgeData = judgesData.judges.find(jd => jd.key === j.key) || {};
      return {
        ...j,
        question1: judgeData.question1 || 'What makes your solution defensible?',
        question2: judgeData.question2 || 'How will you acquire your first 100 customers?',
      };
    });

    renderJudges();
    renderQA();
  } catch(e){
    console.error('Failed to generate judges:', e);
    // Fallback questions
    state.judges = judges.map(j => ({
      ...j,
      question1: 'What makes your solution defensible against incumbents?',
      question2: 'How will you acquire your first 100 customers?',
    }));
    renderJudges();
    renderQA();
  }
}

function renderJudges(){
  let html = '';
  state.judges.forEach(j => {
    html += `<div class="judge-card">
      <div class="judge-emoji">${j.emoji}</div>
      <div class="judge-name">${j.name}</div>
      <div class="judge-focus">${j.focus}</div>
      <div class="judge-score" id="score-${j.key}">—</div>
    </div>`;
  });
  document.getElementById('judges-display').innerHTML = html;
}

function renderQA(){
  let html = '';
  state.judges.forEach(judge => {
    html += `<div class="qa-sectio
