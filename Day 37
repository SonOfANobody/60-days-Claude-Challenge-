          </div>
          <div class="chart-item">
            <div class="chart-label">Collaboration</div>
            <div class="chart-bar">
              <div class="chart-fill" id="collaborationBar" style="height: 0%"></div>
              <div class="chart-value" id="collaborationValue">0%</div>
            </div>
          </div>
          <div class="chart-item">
            <div class="chart-label">Workflow Thinking</div>
            <div class="chart-bar">
              <div class="chart-fill" id="workflowBar" style="height: 0%"></div>
              <div class="chart-value" id="workflowValue">0%</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-bottom: 16px; font-size: 20px;">Your Reflections</h2>
      <div id="reflectionContent"></div>
    </div>

    <div class="card">
      <button class="btn btn-block" onclick="resetGame()">Start Over</button>
    </div>
  </div>
</div>

