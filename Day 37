      <h1>📍 Task Compass</h1>
    </div>

    <div class="stage-indicator">
      <span class="stage-dot"></span>
      <span>Stage 1: Ownership</span>
      <span class="stage-dot"></span>
      <span>Stage 2: Routing</span>
      <span class="stage-dot active"></span>
      <span>Stage 3: Collaboration</span>
    </div>

    <div class="progress-bar">
      <div class="progress-fill" style="width: 99%"></div>
    </div>

    <div class="card">
      <div id="stage3Content"></div>
    </div>
  </div>

  <!-- RESULTS -->
  <div id="resultsScreen" class="screen">
    <div class="header">
      <h1>📍 Task Compass</h1>
    </div>

    <div class="progress-bar">
      <div class="progress-fill" style="width: 100%"></div>
    </div>

    <div class="celebration">
      <div class="celebration-emoji">🎯</div>
      <div class="celebration-text">Journey Complete</div>
      <div class="celebration-subtitle">You've explored how work flows through organizations</div>
    </div>

    <div class="card">
