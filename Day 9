<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutriScope Pro — Advanced Nutritional Analytics</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #111827;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 3px;
        }
        .glass-card {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="min-h-screen pb-12 custom-scrollbar">

    <header class="border-b border-gray-800 bg-gray-900/50 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-gradient-to-tr from-emerald-500 to-cyan-500 rounded-xl shadow-lg shadow-emerald-500/20">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent">NutriScope <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 ml-1 inline-block align-middle">Pro v2.0</span></h1>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <label class="cursor-pointer flex items-center space-x-2 bg-gray-800 hover:bg-gray-700 transition px-4 py-2 rounded-xl text-sm border border-gray-700 text-gray-300 font-medium">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    <span>Import Logs (CSV)</span>
                    <input type="file" id="csvUpload" accept=".csv" class="hidden" onchange="handleCSVUpload(event)">
                </label>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-4 space-y-6">
            <section class="glass-card rounded-2xl p-6 shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Biometrics & Profile
                    </h2>
                    <span class="w-2 h-2 rounded-full bg-emerald-500 dynamic-pulse"></span>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Age</label>
                        <input type="number" id="age" value="25" min="1" max="120" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Gender</label>
                        <select id="gender" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Height (cm)</label>
                        <input type="number" id="height" value="175" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Weight (kg)</label>
                        <input type="number" id="weight" value="70" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                    </div>
                </div>
                <div class="mt-4">
                    <label class="block text-xs font-medium text-gray-400 mb-1">Physical Activity Level</label>
                    <select id="activity" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                        <option value="1.2">Sedentary (Little to no exercise)</option>
                        <option value="1.375">Lightly Active (Light exercise 1-3 days/wk)</option>
                        <option value="1.55" selected>Moderately Active (Moderate exercise 3-5 days/wk)</option>
                        <option value="1.725">Very Active (Hard exercise 6-7 days/wk)</option>
                    </select>
                </div>
                <div class="mt-4">
                    <label class="block text-xs font-medium text-gray-400 mb-1">Dietary Paradigm</label>
                    <select id="diet" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition" onchange="updateAnalytics()">
                        <option value="Non-Vegetarian">Non-Vegetarian</option>
                        <option value="Vegetarian">Vegetarian</option>
                        <option value="Eggetarian">Eggetarian</option>
                    </select>
                </div>
            </section>

            <section class="glass-card rounded-2xl p-6 shadow-xl">
                <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Log Consumption
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Select Food Item</label>
                        <select id="foodSelect" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition search-select">
                            </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-400 mb-1">Quantity</label>
                            <input type="number" id="foodQty" value="100" min="1" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-400 mb-1">Unit</label>
                            <select id="foodUnit" class="w-full bg-gray-900/60 border border-gray-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500 transition">
                                <option value="g">Grams (g)</option>
                                <option value="ml">Milliliters (ml)</option>
                            </select>
                        </div>
                    </div>
                    <button onclick="addFoodLog()" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-medium py-2.5 px-4 rounded-xl shadow-lg shadow-emerald-950/40 transition active:scale-[0.98] mt-2">
                        Commit Entry to Log
                    </button>
                </div>
            </section>

            <section class="border border-amber-500/20 bg-amber-500/5 rounded-2xl p-5">
                <h3 class="text-sm font-semibold text-amber-400 flex items-center gap-2 mb-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    Clinical & Software Disclaimer
                </h3>
                <p class="text-xs text-amber-300/80 leading-relaxed">
                    NutriScope Pro provides nutritional estimations computed algorithmically based on public dietary analytics. It does not constitute medical advice or substitute specialized clinical assessment. Consult a registered dietitian or healthcare practitioner prior to pursuing significant dietary modifications.
                </p>
            </section>
        </div>

        <div class="lg:col-span-8 space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Energy Requirements</p>
                        <h3 class="text-3xl font-bold text-white mt-1" id="calBurnText">0 <span class="text-sm text-gray-500 font-normal">kcal/day</span></h3>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-800 text-xs text-gray-400">
                        Derived via the <span class="text-cyan-400">Mifflin-St Jeor</span> metric.
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Logged Intake</p>
                        <h3 class="text-3xl font-bold text-emerald-400 mt-1" id="calIntakeText">0 <span class="text-sm text-gray-500 font-normal">kcal</span></h3>
                    </div>
                    <div class="mt-4">
                        <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
                            <div id="energyBar" class="bg-gradient-to-r from-emerald-400 to-cyan-500 h-full w-0 transition-all duration-500"></div>
                        </div>
                        <div class="flex justify-between text-[10px] text-gray-400 mt-1">
                            <span id="energyPct">0% Consumed</span>
                            <span id="energyRemaining">Remaining: 0 kcal</span>
                        </div>
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Data Consistency</p>
                        <div class="flex items-center gap-2 mt-2">
                            <span class="px-2 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-semibold rounded-md border border-emerald-500/20">Verified DB</span>
                            <span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-semibold rounded-md border border-cyan-500/20">60 Items</span>
                        </div>
                    </div>
                    <div class="mt-4 text-xs text-gray-400">
                        Sourced via <span class="underline text-gray-300">ICMR-NIN & USDA National Nutrient Database</span>.
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="glass-card rounded-2xl p-5">
                    <h3 class="text-sm font-semibold text-white mb-4 uppercase tracking-wider text-gray-400">Macronutrient Target Distribution (g)</h3>
                    <div class="h-64 relative flex items-center justify-center">
                        <canvas id="macroChart"></canvas>
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-5">
                    <h3 class="text-sm font-semibold text-white mb-4 uppercase tracking-wider text-gray-400">Micronutrient Target Status (%)</h3>
                    <div class="h-64 relative flex items-center justify-center">
                        <canvas id="microChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass-card rounded-2xl p-5 border-l-4 border-rose-500">
                    <h4 class="text-xs font-bold text-rose-400 uppercase tracking-wider mb-2">Critical Deficiencies</h4>
                    <ul id="deficiencyList" class="space-y-1 text-sm text-gray-300">
                        <li class="text-gray-500 text-xs italic">Clear and structural targets met.</li>
                    </ul>
                </div>
                <div class="glass-card rounded-2xl p-5 border-l-4 border-amber-500">
                    <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">Elevated Overages</h4>
                    <ul id="excessList" class="space-y-1 text-sm text-gray-300">
                        <li class="text-gray-500 text-xs italic">No structural overages flagged.</li>
                    </ul>
                </div>
                <div class="glass-card rounded-2xl p-5 border-l-4 border-cyan-500">
                    <h4 class="text-xs font-bold text-cyan-400 uppercase tracking-wider mb-2">Cardiovascular Risk Screening</h4>
                    <div id="riskAnalysis" class="text-xs text-gray-300 space-y-1">
                        </div>
                </div>
            </div>

            <section class="glass-card rounded-2xl overflow-hidden shadow-xl">
                <div class="p-5 border-b border-gray-800 flex justify-between items-center">
                    <h3 class="font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        Granular Consumption Logs
                    </h3>
                    <button onclick="clearLogs()" class="text-xs text-gray-400 hover:text-rose-400 font-medium transition">Clear All Entries</button>
                </div>
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-900/80 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-800">
                                <th class="py-3 px-4">Item Component</th>
                                <th class="py-3 px-4 text-right">Mass/Vol</th>
                                <th class="py-3 px-4 text-right">Energy (kcal)</th>
                                <th class="py-3 px-4 text-right">Prot (g)</th>
                                <th class="py-3 px-4 text-right">Carb (g)</th>
                                <th class="py-3 px-4 text-right">Fat (g)</th>
                                <th class="py-3 px-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="logTableBody" class="text-sm divide-y divide-gray-800/60 text-gray-300">
                            </tbody>
                    </table>
                    <div id="emptyLogState" class="p-8 text-center text-xs text-gray-500 italic">
                        No food elements actively logged for the current micro-cycle.
                    </div>
                </div>
            </section>

            <section class="glass-card rounded-2xl overflow-hidden shadow-xl">
                <div class="p-5 border-b border-gray-800">
                    <h3 class="font-semibold text-white">Full-Spectrum Micronutrient Tracking</h3>
                </div>
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-900/80 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-800">
                                <th class="py-3 px-4">Nutrient Metric</th>
                                <th class="py-3 px-4 text-right">Target Demand</th>
                                <th class="py-3 px-4 text-right">Current Status</th>
                                <th class="py-3 px-4 text-right">Yield %</th>
                                <th class="py-3 px-4">Status Map</th>
                            </tr>
                        </thead>
                        <tbody id="nutrientTableBody" class="text-sm divide-y divide-gray-800/60 text-gray-300">
                            </tbody>
                    </table>
                </div>
            </section>

            <section class="glass-card rounded-2xl p-6 shadow-xl space-y-4">
                <h3 class="font-semibold text-white text-base flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                    Smart Insights & Targeted Food Swaps
                </h3>
                <div id="recommendationEngine" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    </div>
            </section>

            <section class="glass-card rounded-2xl p-6 shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-semibold text-white text-base flex items-center gap-2">
                        <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-
