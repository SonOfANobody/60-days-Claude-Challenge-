  <div class="modal-content" style="max-width: 700px;">
    <div class="modal-header">
      <div class="modal-title">How to Use Your AI Playbook</div>
      <button class="modal-close" onclick="closeHelp()">×</button>
    </div>
    <div class="modal-body">
