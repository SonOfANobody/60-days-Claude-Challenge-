<script>
// ============================================
// STATE MANAGEMENT
// ============================================
let conversationHistory = [];
let isLoading = false;

const systemPrompt = `You are Clarity, a compassionate mental health support specialist with deep knowledge of psychology, stress management, and emotional wellness. Your role is to provide immediate, expert support to people experiencing stress, anxiety, or emotional challenges.

**Your Approach:**
- Start by deeply listening and validating their experience. Make them feel heard.
- Ask clarifying questions to understand the root of their stress.
- Provide evidence-based coping strategies (grounding, breathing, cognitive reframing).
- Offer practical, actionable techniques they can use immediately.
- Use warm, empathetic language that balances professional expertise with human connection.

**Tone:** Professional but warm. Clinical knowledge + genuine empathy. Never clinical without care.

**Core Techniques You Should Use:**
1. Validation - Acknowledge their feelings as real and understandable
2. Active Listening - Reflect back what you hear to show understanding
3. Grounding - Help them anchor to the present moment
4. Cognitive Reframing - Help reframe unhelpful thought patterns
5. Breathing & Somatic - Suggest body-based practices for nervous system regulation

**What You Won't Do:**
- Provide diagnosis or clinical assessment
- Replace therapy or professional treatment
- Give medical advice
- Make catastrophic predictions
- Minimize their experience

**When to Encourage Professional Help:**
- Mention if they seem to be experiencing depression, suicidal thoughts, or severe anxiety
- Suggest therapy if patterns indicate deeper issues
- Recommend crisis lines if they mention harm
- Always frame as supportive, not as dismissal

**Output Format:**
- Keep responses conversational and warm
- Use short paragraphs (2-3 sentences max)
- End most responses with a supportive question or next step
- Share one specific technique per conversation turn (don't overwhelm)
- Be specific and personalized, not generic

**Session Goal:**
By the end of the conversation, the user should feel:
1. Heard and validated
2. Less alone in their experience
3. Armed with at least one practical coping tool
4. Empowered to take next steps (professional help, self-care, etc.)

Remember: You're not solving their problem. You're walking with them toward relief and clarity.`;

// ============================================
// UI FUNCTIONS
// ============================================
function toggleDocs() {
  const panel = document.getElementById('docsPanel');
  const overlay = document.getElementById('docsOverlay');
  panel.classList.toggle('open');
  overlay.classList.toggle('show');
}

function resetChat() {
  if (confirm('Start a new conversation? This will clear your current chat.')) {
    conversationHistory = [];
    document.getElementById('messagesArea').innerHTML = `
      <div class="empty-state">
        <div class="empty-icon">🧘</div>
        <div class="empty-title">Welcome to Clarity</div>
        <div class="empty-subtitle">
          A safe space to talk through what's on your mind. Share what you're experiencing, and I'll listen with warmth and expertise to help you find relief and clarity.
        </div>
      </div>
    `;
    document.getElementById('inputField').value = '';
    document.getElementById('inputField').focus();
  }
}

// ============================================
// CHAT FUNCTIONS
// ============================================
function sendMessage() {
  const input = document.getElementById('inputField');
  const message = input.value.trim();

  if (!message || isLoading) return;

  // Clear empty state
  const emptyState = document.querySelector('.empty-state');
  if (emptyState) emptyState.remove();

  // Add user message
  addMessage(message, 'user');
  input.value = '';
  input.style.height = 'auto';

  // Get AI response
  isLoading = true;
  document.getElementById('sendBtn').disabled = true;
  showLoadingIndicator();

  callClaudeAPI(message);
}

function addMessage(content, role) {
  const messagesArea = document.getElementById('messagesArea');
  const messageEl = document.createElement('div');
  messageEl.className = `message ${role}`;

  let messageContent = content;
  if (role === 'assistant') {
    messageContent = `<div class="loading-dots">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>`;
  }

  messageEl.innerHTML = `<div class="message-content">${messageContent}</div>`;
  messagesArea.appendChild(messageEl);
  messagesArea.scrollTop = messagesArea.scrollHeight;

  if (role !== 'assistant') {
    conversationHistory.push({ role: 'user', content });
  }

  return messageEl;
}

function showLoadingIndicator() {
  addMessage('', 'assistant');
}

function updateLastMessage(content) {
  const messages = document.querySelectorAll('.message.assistant');
  if (messages.length > 0) {
    const lastMessage = messages[messages.length - 1];
    lastMessage.querySelector('.message-content').innerHTML = content;
  }
}

// ============================================
// API INTEGRATION
// ============================================
async function callClaudeAPI(userMessage) {
  try {
    const messages = [
      ...conversationHistory,
      { role: 'user', content: userMessage }
    ];

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': getAPIKey(),
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-opus-4-6',
        max_tokens: 1024,
        system: systemPrompt,
        messages: messages
      })
    });

    if (!response.ok) {
      if (response.status === 401) {
        throw new Error('Invalid API key. Please check your configuration.');
      }
      throw new Error(`API Error: ${response.status}`);
    }

    const data = await response.json();
    const assistantMessage = data.content[0].text;

    conversationHistory.push({ role: 'user', content: userMessage });
    conversationHistory.push({ role: 'assistant', content: assistantMessage });

    updateLastMessage(assistantMessage);
  } catch (error) {
    updateLastMessage(`I encountered an error: ${error.message}. Please check your API key and try again.`);
  } finally {
    isLoading = false;
    document.getElementById('sendBtn').disabled = false;
  }
}

function getAPIKey() {
  const key = prompt('Please enter your Claude API key:');
  if (!key) throw new Error('API key required');
  return key;
}

// ============================================
// INPUT AUTO-RESIZE
// ============================================
document.getElementById('inputField').addEventListener('input', function() {
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 100) + 'px';
});

// ============================================
// ENTER TO SEND
// ============================================
document.getElementById('inputField').addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

// Focus input on load
document.getElementB
