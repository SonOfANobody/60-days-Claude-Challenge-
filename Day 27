function appendChatBubble(speaker, text) {
  const container = document.getElementById('chatContainer');
  const bubble = document.createElement('div');
  bubble.className = 'chat-bubble ' + (speaker === 'rahul' ? 'left' : 'right');

  if (speaker === 'narrator') {
    bubble.innerHTML = `<div class="narrator-text">${text}</div>`;
  } else if (speaker === 'education') {
    bubble.innerHTML = `<div class="education-box"><div class="education-title">${text.title}</div><div>${text.text}</div></div>`;
  } else if (speaker === 'citation') {
    bubble.innerHTML = `<div class="citation">${text}</div>`;
  } else {
    const speakerClass = speaker === 'rahul' ? 'rahul' : 'priya';
    const speakerName = speaker === 'rahul' ? '👦 Rahul' : '👧 Priya';
    bubble.innerHTML = `
      <div style="width: 100%;">
        <div class="speaker-label ${speakerClass}">${speakerName}</div>
        <div class="bubble-content ${speakerClass}">${text}</div>
      </div>
    `;
  }

  container.appendChild(bubble);
  scrollToBottom();
}

