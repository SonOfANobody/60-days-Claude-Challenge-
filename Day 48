<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Compare & Decide Builder - Analytics Platform Comparison</title>
<style>
:root {
  --primary: #2563eb;
  --primary-light: #3b82f6;
  --secondary: #1e40af;
  --accent: #0369a1;
  --success: #059669;
  --warning: #d97706;
  --danger: #dc2626;
  
  --bg-dark: #0f172a;
  --bg-darker: #0a0e27;
  --bg-card: #1e293b;
  --bg-input: #1a2641;
  --bg-hover: #2d3d54;
  
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  
  --border: rgba(255,255,255,0.08);
  --shadow-sm: 0 2px 4px rgba(0,0,0,0.2);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.3);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: linear-gradient(135deg, var(--bg-dark) 0%, var(--bg-darker) 100%);
  color: var(--text-primary);
  min-height: 100vh;
}

body { padding: 0; }

.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(135deg, rgba(37,99,235,0.12), rgba(30,64,175,0.08));
  border-bottom: 1px solid var(--border);
  padding: 32px 24px;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.header-container {
  max-width: 1400px;
  margin: 0 auto;
}

.header h1 {
  font-size: 32px;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.header-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
}

.container {
  flex: 1;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  padding: 32px 24px;
}

.comparison-section {
  margin-bottom: 32px;
}

.section-title {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 24px;
  color: var(--text-primary);
}

.comparison-table {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.table-header {
  display: grid;
  grid-template-columns: 200px repeat(4, 1fr);
  gap: 0;
  background: var(--bg-input);
  border-bottom: 1px solid var(--border);
  padding: 0;
}

.header-cell {
  padding: 16px;
  font-weight: 700;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
  text-align: center;
  border-right: 1px solid var(--border);
}

.header-cell:first-child {
  text-align: left;
}

.header-cell:last-child {
  border-right: none;
}

.table-row {
  display: grid;
  grid-template-columns: 200px repeat(4, 1fr);
  gap: 0;
  border-bottom: 1px solid var(--border);
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  padding: 16px;
  border-right: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
}

.table-cell:last-child {
  border-right: none;
}

.criteria-name {
  text-align: left;
  font-weight: 600;
  color: var(--text-primary);
  padding: 16px;
}

.score-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-direction: column;
  height: 100%;
}

.score-bar {
  width: 100%;
  height: 20px;
  background: rgba(255,255,255,0.05);
  border-radius: 10px;
  overflow: hidden;
  margin: 4px 0;
}

.score-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  width: var(--width);
  transition: width 0.4s ease;
}

.score-value {
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
}

.note {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 4px;
  font-style: italic;
}

.ranking-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 32px;
  box-shadow: var(--shadow-md);
}

.ranking-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 20px;
  color: var(--text-primary);
}

.ranking-items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ranking-item {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  display: grid;
  grid-template-columns: 40px 1fr 100px;
  gap: 16px;
  align-items: center;
  transition: all 0.3s ease;
}

.ranking-item:hover {
  border-color: var(--primary);
  background: var(--bg-hover);
}

.ranking-badge {
  font-size: 20px;
  font-weight: 800;
  text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.ranking-name {
  font-weight: 700;
  color: var(--text-primary);
}

.ranking-score {
  font-size: 18px;
  font-weight: 800;
  text-align: right;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.controls-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 32px;
  box-shadow: var(--shadow-md);
}

.controls-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 24px;
  color: var(--text-primary);
}

.weight-group {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.weight-group:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.weight-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.weight-name {
  font-weight: 600;
  color: var(--text-primary);
  font-size: 13px;
}

.weight-value {
  font-size: 13px;
  font-weight: 700;
  color: var(--primary);
}

.weight-slider {
  width: 100%;
  height: 6px;
  border-radius: 3px;
  background: rgba(255,255,255,0.1);
  outline: none;
  -webkit-appearance: none;
  appearance: none;
  cursor: pointer;
}

.weight-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--primary);
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(37,99,235,0.4);
}

.weight-slider::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--primary);
  cursor: pointer;
  border: none;
  box-shadow: 0 2px 8px rgba(37,99,235,0.4);
}

.reset-button {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.reset-button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.collapsible-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  margin-bottom: 24px;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.collapsible-header {
  padding: 20px;
  background: var(--bg-input);
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
  transition: all 0.2s ease;
}

.collapsible-header:hover {
  background: var(--bg-hover);
}

.collapsible-title {
  font-weight: 700;
  color: var(--text-primary);
  font-size: 14px;
}

.collapsible-toggle {
  color: var(--text-secondary);
  font-size: 20px;
  transition: transform 0.3s ease;
}

.collapsible-toggle.open {
  transform: rotate(180deg);
}

.collapsible-content {
  padding: 20px;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.collapsible-content.open {
  max-height: 2000px;
}

.sources-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.source-item {
  background: var(--bg-input);
  border-left: 3px solid var(--primary);
  padding: 12px;
  border-radius: 6px;
  font-size: 12px;
}

.source-label {
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4px;
}

.source-text {
  color: var(--text-secondary);
  line-height: 1.6;
}

.source-cite {
  color: var(--text-muted);
  font-style: italic;
  margin-top: 4px;
}

.research-note {
  background: rgba(217,119,6,0.1);
  border-left: 3px solid var(--warning);
  padding: 12px;
  border-radius: 6px;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 16px;
}

.research-note.estimate {
  background: rgba(59,130,246,0.1);
  border-left-color: var(--primary);
}

@media (max-width: 1024px) {
  .table-header, .table-row {
    grid-template-columns: 140px repeat(4, 1fr);
  }

  .header-cell, .table-cell {
    padding: 12px;
    font-size: 11px;
  }
}

@media (max-width: 768px) {
  .header {
    padding: 20px 16px;
  }

  .header h1 {
    font-size: 24px;
  }

  .container {
    padding: 16px;
  }

  .table-header, .table-row {
    grid-template-columns: 100px repeat(4, 1fr);
  }

  .criteria-name {
    padding: 12px;
    font-size: 11px;
  }

  .ranking-item {
    grid-template-columns: 30px 1fr 80px;
    padding: 12px;
  }
}
</style>
</head>
