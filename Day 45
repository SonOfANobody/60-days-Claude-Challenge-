<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Decision Report — School Fees vs Tools Investment</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg-main: #0f0f14;
  --bg-card: #1a1a24;
  --bg-card-alt: #1e1e2e;
  --text-primary: #f0f0f5;
  --text-secondary: #8888a0;
  --accent-green: #34d399;
  --accent-red: #f87171;
  --accent-blue: #60a5fa;
  --accent-gold: #fbbf24;
  --accent-purple: #a78bfa;
  --border-subtle: rgba(255,255,255,0.06);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  background: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.7;
}

body {
  padding: 40px 20px;
}

.container {
  max-width: 720px;
  margin: 0 auto;
}

/* HEADER */
.header {
  text-align: center;
  margin-bottom: 48px;
  padding-bottom: 32px;
  border-bottom: 2px solid;
  border-image: linear-gradient(90deg, var(--accent-blue), var(--accent-purple), var(--accent-gold)) 1;
}

.header-title {
  font-size: 28px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.header-subtitle {
  font-size: 16px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.header-date {
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* CARD BASE */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 28px;
  margin-bottom: 28px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.3);
  transition: all 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 32px rgba(0,0,0,0.4);
}

.card-title {
  font-size: 20px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 20px;
}

/* SECTION 1 - REAL DECISION */
.card-section-1 {
  border-left: 4px solid var(--accent-blue);
}

.card-section-1 .card-title {
  color: var(--accent-blue);
}

.decision-text {
  font-size: 15px;
  line-height: 1.8;
  color: var(--text-primary);
  margin-bottom: 16px;
}

.decision-text strong {
  color: var(--accent-gold);
}

/* SECTION 2 - CASE FOR EACH OPTION */
.card-section-2 {
  border-left: 4px solid var(--accent-green);
}

.card-section-2 .card-title {
  color: var(--accent-green);
}

.option-card {
  background: var(--bg-card-alt);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
}

.option-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--accent-green);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.option-section {
  margin-bottom: 12px;
}

.option-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.option-text {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

.option-text.weakness {
  color: var(--accent-red);
}

.option-text.upside {
  color: var(--accent-gold);
}

/* SECTION 3 - ASSUMPTION BUSTER */
.card-section-3 {
  border-left: 4px solid var(--accent-purple);
}

.card-section-3 .card-title {
  color: var(--accent-purple);
}

.assumption-item {
  background: var(--bg-card-alt);
  border-left: 3px solid var(--accent-purple);
  padding: 16px;
  margin-bottom: 12px;
  border-radius: 8px;
}

.assumption-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.assumption-text {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

.bias-label {
  display: inline-block;
  background: rgba(167,139,250,0.2);
  color: var(--accent-purple);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  margin-right: 8px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.ignore-item {
  background: rgba(248,113,113,0.1);
  border-left: 3px solid var(--accent-red);
  padding: 16px;
  margin-top: 12px;
  border-radius: 8px;
}

/* SECTION 4 - DECISION MATRIX */
.card-section-4 {
  border-left: 4px solid var(--accent-blue);
}

.card-section-4 .card-title {
  color: var(--accent-blue);
}

.matrix-row {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
  gap: 16px;
}

.matrix-label {
  width: 35%;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  color: var(--text-secondary);
}

.matrix-bars {
  width: 65%;
  display: flex;
  gap: 8px;
}

.matrix-bar-container {
  flex: 1;
}

.matrix-bar-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.bar {
  height: 28px;
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 10px;
  font-weight: 700;
  font-size: 12px;
  color: white;
  animation: fillBar 0.8s ease-out forwards;
}

.bar-fill.option-a {
  background: linear-gradient(90deg, #60a5fa, #3b82f6);
}

.bar-fill.option-b {
  background: linear-gradient(90deg, #34d399, #10b981);
}

@keyframes fillBar {
  from {
    width: 0;
  }
  to {
    width: var(--width);
  }
}

.matrix-total {
  background: rgba(96,165,250,0.1);
  border: 1px solid var(--accent-blue);
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  margin-top: 20px;
}

.matrix-total-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.matrix-total-scores {
  display: flex;
  justify-content: center;
  gap: 24px;
  font-size: 20px;
  font-weight: 800;
}

.matrix-total-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.matrix-total-score-label {
  font-size: 11px;
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
}

.matrix-total-score-value {
  color: var(--accent-blue);
}

/* SECTION 5 - PREMORTEM */
.card-section-5 {
  border-left: 4px solid var(--accent-red);
}

.card-section-5 .card-title {
  color: var(--accent-red);
}

.premortem-option {
  margin-bottom: 28px;
}

.premortem-option-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.premortem-section {
  background: var(--bg-card-alt);
  border-left: 3px solid var(--accent-red);
  padding: 16px;
  margin-bottom: 10px;
  border-radius: 8px;
}

.premortem-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  color: var(--accent-red);
  margin-bottom: 8px;
}

.premortem-text {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

/* SECTION 6 - 7-DAY TEST PLAN */
.card-section-6 {
  border-left: 4px solid var(--accent-green);
}

.card-section-6 .card-title {
  color: var(--accent-green);
}

.day-item {
  background: var(--bg-card-alt);
  border-left: 3px solid var(--accent-green);
  padding: 16px;
  margin-bottom: 12px;
  border-radius: 8px;
}

.day-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  color: var(--accent-green);
  margin-bottom: 6px;
}

.day-text {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

/* SECTION 7 - VERDICT */
.card-section-7 {
  border-left: 4px solid var(--accent-gold);
  background: var(--bg-card-alt);
  box-shadow: 0 0 20px rgba(251,191,36,0.15);
  padding: 32px;
}

.card-section-7 .card-title {
  color: var(--accent-gold);
}

.verdict-option {
  font-size: 32px;
  font-weight: 800;
  color: var(--accent-gold);
  margin-bottom: 16px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.verdict-reason {
  font-size: 15px;
  color: var(--text-primary);
  line-height: 1.8;
  margin-bottom: 16px;
}

.verdict-condition {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-subtle);
}

.verdict-hard-truth {
  font-size: 15px;
  color: var(--text-secondary);
  font-style: italic;
  line-height: 1.8;
}

/* SECTION 8 - SHAREABLE CARDS */
.card-section-8 {
  border-left: 4px solid var(--accent-gold);
}

.card-section-8 .card-title {
  color: var(--accent-gold);
}

.shareable-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 20px;
}

.shareable-card {
  background: var(--bg-card-alt);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 240px;
  position: relative;
}

.shareable-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.shareable-title {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--accent-gold);
  margin-bottom: 12px;
}

.shareable-text {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.shareable-text.secondary {
  font-size: 12px;
  color: var(--text-secondary);
}

.shareable-watermark {
  font-size: 10px;
  color: var(--text-secondary);
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
  text-align: center;
}

/* FOOTER */
.footer {
  text-align: center;
  margin-top: 40px;
  padding-top: 32px;
  border-top: 1px solid var(--border-subtle);
  font-size: 12px;
  color: var(--text-secondary);
}

/* RESPONSIVE */
@media (max-width: 600px) {
  body {
    padding: 20px 12px;
  }

  .container {
    max-width: 100%;
  }

  .card {
    padding: 20px;
    margin-bottom: 20px;
  }

  .header-title {
    font-size: 22px;
  }

  .header-subtitle {
    font-size: 14px;
  }

  .card-title {
    font-size: 16px;
  }

  .matrix-row {
    flex-direction: column;
    gap: 8px;
  }

  .matrix-label {
    width: 100%;
  }

  .matrix-bars {
    width: 100%;
  }

  .shareable-grid {
    grid-template-columns: 1fr;
  }

  .verdict-option {
    font-size: 24px;
  }
}
</style>
</head>
<body>

<div class="container">
  <!-- HEADER -->
  <div class="header">
    <div class="header-title">Decision Report</div>
    <div class="header-subtitle">School Fees vs Tools: Building Your Future</div>
    <div class="header-date">Generated Today • Day 45 Challenge</div>
  </div>

  <!-- SECTION 1: THE REAL DECISION -->
  <div class="card card-section-1">
    <div class="card-title">The Real Decision</div>
    <div class="decision-text">
      You're juggling two non-negotiables: <strong>getting education funded (school fees by September)</strong> and <strong>getting the tools to build your 1M business</strong> (laptop + phone by February). Both matter for your goal of generational wealth, but money is tight right now—you're still saving for September fees. The hard part: you can't do both at once. Choose wrong and you either derail education or cripple your ability to execute on business.
    </div>
  </div>

  <!-- SECTION 2: CASE FOR EACH OPTION -->
  <div class="card card-section-2">
    <div class="card-title">The Case for Each Option</div>

    <div class="option-card">
      <div class="option-name">Option A: Prioritize School Fees (Sept)</div>
      <div class="option-section">
        <div class="option-label">Strongest Case</div>
        <div class="option-text">Education is the foundation. You can't build 1M company without formal credentials + degree—doors close without it. School fees by September keeps you on track. You can bootstrap tools with phone for now.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Hidden Upside</div>
        <div class="option-text upside">University network + credibility + time to learn AI theory properly = better business positioning later. Employers/investors trust degree holders. You'll network with future co-founders, investors, collaborators.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Biggest Weakness</div>
        <div class="option-text weakness">Managing business solo on phone for 5 months (Sept-Feb) is grinding. No laptop = slower coding, slower building, frustration. You might lose momentum or miss opportunities that need faster execution.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Best If You Value</div>
        <div class="option-text">Long-term credibility, doors staying open, not risking education, theory + credentials as business moat.</div>
      </div>
    </div>

    <div class="option-card">
      <div class="option-name">Option B: Split Money, Get Tools First (Now)</div>
      <div class="option-section">
        <div class="option-label">Strongest Case</div>
        <div class="option-text">Laptop now = you execute faster, ship more, build credibility through shipped code. Phone + laptop = professional presence. You could earn MORE by February, making school fees easier to fund. Business momentum compounds.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Hidden Upside</div>
        <div class="option-text upside">Real experience building + shipping > degree on resume. If you prove revenue/traction by September, school fees become optional (you can defer, take loans, or fund it from business). Investors bet on execution, not credentials.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Biggest Weakness</div>
        <div class="option-text weakness">School fees don't happen Sept. You defer or don't enroll. That's a psychological + practical hit. Doors close (no degree = harder to raise capital later, hire, get credibility). Pressure on business to "make up" for skipped education.</div>
      </div>
      <div class="option-section">
        <div class="option-label">Best If You Value</div>
        <div class="option-text">Speed to execution, proving yourself through code/results, betting on business revenue solving everything.</div>
      </div>
    </div>
  </div>

  <!-- SECTION 3: ASSUMPTION BUSTER -->
  <div class="card card-section-3">
    <div class="card-title">Assumption Buster</div>

    <div class="assumption-item">
      <div class="assumption-label">Assumption 1</div>
      <div class="assumption-text">"I can't build a successful business without laptop+phone right now."</div>
      <p style="font-size: 12px; color: var(--text-secondary); margin-top: 8px; line-height: 1.6;"><strong>Reality check:</strong> You've been learning AI on phone + limited resources. That's already hard-mode. A laptop speeds things up, but won't make or break a 1M business if the idea is solid. Constraint breeds creativity.</p>
    </div>

    <div class="assumption-item">
      <div class="assumption-label">Assumption 2</div>
      <div class="assumption-text">"I must have school fees fully saved by September—no other way."</div>
      <p style="font-size: 12px; color: var(--text-secondary); margin-top: 8px; line-height: 1.6;"><strong>Reality check:</strong> Most Nigerian universities allow payment plans, partial payment + follow-up, or deferment. You don't need 100% cash Sept 1. This is more flexible than you think.</p>
    </div>

    <div class="assumption-item">
      <div class="assumption-label">Assumption 3</div>
      <div class="assumption-text">"These two goals are mutually exclusive."</div>
      <p style="font-size: 12px; color: var(--text-secondary); margin-top: 8px; line-height: 1.6;"><strong>Reality check:</strong> They're not. You could: (1) get refurb/budget laptop now ($200-400), keep aggressively saving for fees, (2) use business to fund gap by Sept, (3) negotiate school payment plan. False binary.</p>
    </div>

    <div style="margin-top: 16px;">
      <div style="margin-bottom: 12px;">
        <span class="bias-label">Bias 1: Loss Aversion</span>
        <p style="font-size: 12px; color: var(--text-secondary); margin-top: 6px;">You're more afraid of losing the opportunity to attend school (if you miss Sept) than you are excited about the upside of having tools now. This fear is making you default to "school first" without exploring third options.</p>
      </div>
      <div>
        <span class="bias-label">Bias 2: Status Quo Bias</span>
        <p style="font-size: 12px; color: var(--text-secondary); margin-top: 6px;">Your original plan (school Sept, tools Feb) feels "safe" because it's what you committed to. You're not seriously exploring hybrid paths because changing course feels like failure, even if it's smarter.</p>
      </div>
    </div>

    <div class="ignore-item">
      <div class="option-label">1 Thing You're Ignoring</div>
      <div class="assumption-text">You can earn money between now and September by shipping AI projects (Kaggle, freelance, B2B AI services). Even $200-500 side revenue would fund a refurb laptop AND take pressure off school fees. You're not treating the business as a revenue source for THIS problem—you're only seeing it as a long-term wealth play.</div>
    </div>
  </div>

  <!-- SECTION 4: DECISION MATRIX -->
  <div class="card card-section-4">
    <div class="card-title">Decision Matrix</div>
    <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px;">Scoring each option (0-10) across 7 dimensions. Higher is better.</p>

    <!-- Life/Career Upside -->
    <div class="matrix-row">
      <div class="matrix-label">Life/Career Upside</div>
      <div class="matrix-bars">
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">School First</div>
          <div class="bar">
            <div class="bar-fill option-a" style="--width: 75%; animation-delay: 0s;">7.5</div>
          </div>
        </div>
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">Tools First</div>
          <div class="bar">
            <div class="bar-fill option-b" style="--width: 85%; animation-delay: 0.1s;">8.5</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Financial Safety -->
    <div class="matrix-row">
      <div class="matrix-label">Financial Safety</div>
      <div class="matrix-bars">
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">School First</div>
          <div class="bar">
            <div class="bar-fill option-a" style="--width: 80%; animation-delay: 0.1s;">8.0</div>
          </div>
        </div>
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">Tools First</div>
          <div class="bar">
            <div class="bar-fill option-b" style="--width: 60%; animation-delay: 0.15s;">6.0</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Growth & Learning -->
    <div class="matrix-row">
      <div class="matrix-label">Growth & Learning</div>
      <div class="matrix-bars">
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">School First</div>
          <div class="bar">
            <div class="bar-fill option-a" style="--width: 70%; animation-delay: 0.2s;">7.0</div>
          </div>
        </div>
        <div class="matrix-bar-container">
          <div class="matrix-bar-label">Tools First</div>
          <div class="bar">
            <div class="bar-fill option-b" style="--width: 90%; animation-delay: 0.25s;">9.0</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stress Level (10 = low stress) -->
    <div class="matrix-row">
      <div class="matrix-label">Stress Level</div>
      <div class="mat
