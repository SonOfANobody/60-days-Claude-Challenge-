<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Typing Speed Studio</title>
<style>
/* ============================================
   VARIABLES
   ============================================ */
:root {
  --primary: #3b82f6;
  --primary-light: #60a5fa;
  --primary-dark: #1e40af;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --accent: #8b5cf6;
  
  --bg-dark: #0f172a;
  --bg-darker: #0a0e27;
  --bg-card: #1e293b;
  --bg-input: #1a2641;
  
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  
  --correct: #10b981;
  --incorrect: #ef4444;
  --cursor: #3b82f6;
  --untyped: #475569;
  
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
  --shadow-lg: 0 10px 25px rgba(0,0,0,0.2);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
  background: linear-gradient(135deg, var(--bg-dark) 0%, var(--bg-darker) 100%);
  color: var(--text-primary);
  min-height: 100vh;
}

body {
  padding: 16px;
  overflow-x: hidden;
}

#app {
  max-width: 1000px;
  margin: 0 auto;
}

/* ============================================
   HEADER
   ============================================ */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.header-left h1 {
  font-size: 28px;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 4px;
}

.header-right {
  display: flex;
  gap: 12px;
  align-items: center;
}

/* ============================================
   BUTTONS & CONTROLS
   ============================================ */
.btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background: var(--accent);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--primary);
  color: var(--primary);
}

.btn-small {
  padding: 6px 12px;
  font-size: 11px;
}

/* ============================================
   MODE SELECTOR
   ============================================ */
.mode-selector {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}

.mode-btn {
  background: var(--bg-card);
  border: 2px solid rgba(255,255,255,0.1);
  color: var(--text-secondary);
  padding: 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
  font-size: 13px;
}

.mode-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.mode-btn.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-color: var(--primary);
  color: white;
}

/* ============================================
   SETTINGS PANEL
   ============================================ */
.settings-panel {
  background: var(--bg-card);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
  border: 1px solid rgba(255,255,255,0.1);
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}

.setting-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.setting-label {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.setting-control {
  display: flex;
  gap: 8px;
}

.setting-btn {
  background: var(--bg-input);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--text-secondary);
  padding: 6px 12px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.setting-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.setting-btn.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

/* ============================================
   TYPING AREA
   ============================================ */
.typing-container {
  background: var(--bg-card);
  border-radius: 12px;
  padding: 32px;
  margin-bottom: 24px;
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: var(--shadow-lg);
}

.stats-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.stat {
  text-align: center;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--primary);
  font-family: 'Courier New', monospace;
}

.stat-label {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-top: 4px;
}

.text-display {
  background: var(--bg-input);
  border-radius: 8px;
  padding: 24px;
  margin-bottom: 20px;
  font-size: 18px;
  font-family: 'Courier New', monospace;
  line-height: 1.8;
  letter-spacing: 0.02em;
  color: var(--untyped);
  word-wrap: break-word;
  overflow-y: auto;
  max-height: 200px;
  position: relative;
}

.text-display.focus-mode {
  max-height: 80px;
}

.char {
  position: relative;
  transition: color 0.1s ease;
}

.char.correct {
  color: var(--correct);
}

.char.incorrect {
  color: var(--incorrect);
  background: rgba(239, 68, 68, 0.2);
}

.char.cursor {
  background: var(--cursor);
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

.input-area {
  position: relative;
  margin-bottom: 16px;
}

.input-field {
  width: 100%;
  background: var(--bg-input);
  border: 2px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 12px;
  color: var(--text-primary);
  font-size: 16px;
  font-family: 'Courier New', monospace;
  transition: all 0.2s ease;
}

.input-field:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 12px rgba(59, 130, 246, 0.3);
}

.progress-bar {
  width: 100%;
  height: 3px;
  background: rgba(255,255,255,0.1);
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 16px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  transition: width 0.3s ease;
}

.controls {
  display: flex;
  gap: 12px;
  justify-content: center;
}

/* ============================================
   RESULTS PANEL
   ============================================ */
.results-panel {
  background: var(--bg-card);
  border-radius: 12px;
  padding: 32px;
  border: 1px solid rgba(255,255,255,0.1);
  display: none;
}

.results-panel.show {
  display: block;
  animation: slideUp 0.4s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.results-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.result-card {
  background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.05));
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 16px;
  text-align: center;
}

.result-value {
  font-size: 32px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4px;
  font-family: 'Courier New', monospace;
}

.result-label {
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.chart {
  width: 100%;
  height: 200px;
  background: var(--bg-input);
  border-radius: 8px;
  margin-bottom: 24px;
  position: relative;
}

.chart-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 12px;
  color: var(--text-primary);
}

.error-heatmap {
  background: var(--bg-input);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
}

.heatmap-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 12px;
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4px;
}

.heatmap-key {
  width: 100%;
  height: 20px;
  background: linear-gradient(90deg, #10b981, #f59e0b, #ef4444);
  border-radius: 4px;
  margin-top: 12px;
}

.summary-section {
  background: var(--bg-input);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
}

.summary-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-bottom: 8px;
}

.summary-content {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

/* ============================================
   HISTORY PANEL
   ============================================ */
.history-panel {
  background: var(--bg-card);
  border-radius: 12px;
  padding: 24px;
  border: 1px solid rgba(255,255,255,0.1);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.history-item {
  background: var(--bg-input);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s ease;
}

.history-item:hover {
  border: 1px solid var(--primary);
}

.history-info {
  display: flex;
  gap: 16px;
  flex: 1;
}

.history-stat {
  display: flex;
  flex-direction: column;
}

.history-stat-value {
  font-size: 16px;
  font-weight: 700;
  color: var(--primary);
}

.history-stat-label {
  font-size: 11px;
  color: var(--text-muted);
}

.history-date {
  font-size: 12px;
  color: var(--text-muted);
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 768px) {
  .typing-container {
    padding: 16px;
  }

  .text-display {
    font-size: 16px;
    padding: 16px;
  }

  .stats-bar {
    gap: 12px;
  }

  .stat-value {
    font-size: 22px;
  }

  .results-grid {
    gap: 12px;
  }

  .result-card {
    padding: 12px;
  }

  .result-value {
    font-size: 24px;
  }

  .mode-selector {
    grid-template-columns: repeat(2, 1fr);
  }

  .header {
    flex-direction: column;
    gap: 12px;
  }

  .header-right {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  #app {
    padding: 8px;
  }

  .header-left h1 {
    font-size: 20px;
  }

  .typing-container {
    padding: 12px;
  }

  .text-display {
    font-size: 14px;
    padding: 12px;
  }

  .stats-bar {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat-value {
    font-size: 18px;
  }

  .mode-selector {
    grid-template-columns: 1fr;
  }

  .settings-grid {
    grid-template-columns: 1fr;
  }
}

/* ============================================
   UTILITIES
   ============================================ */
.hidden {
  display: none !important;
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
</style>
</head>
<body>

<div id="app">
  <div class="header">
    <div class="header-left">
      <h1>⌨️ Typing Speed Studio</h1>
      <div style="font-size: 12px; color: var(--text-muted);">Adaptive Multi-Category Typing Practice</div>
    </div>
    <div class="header-right">
      <button class="btn btn-outline btn-small" onclick="showSettings()">⚙️ Settings</button>
      <button class="btn btn-outline btn-small" onclick="showHistory()">📊 History</button>
    </div>
  </div>

  <!-- CATEGORY SELECTOR -->
  <div class="settings-panel">
    <div class="setting-label" style="margin-bottom: 12px;">Category</div>
    <div class="mode-selector" id="categorySelector"></div>
  </div>

  <!-- MODE SELECTOR -->
  <div class="settings-panel">
    <div class="setting-label" style="margin-bottom: 12px;">Mode</div>
    <div class="mode-selector" id="modeSelector"></div>
  </div>

  <!-- SETTINGS -->
  <div class="settings-panel" id="advancedSettings" style="display: none;">
    <div class="settings-grid">
      <div class="setting-group">
        <div class="setting-label">Theme</div>
        <div class="setting-control">
          <button class="setting-btn active" onclick="setTheme('dark')">Dark</button>
          <button class="setting-btn" onclick="setTheme('light')">Light</button>
        </div>
      </div>
      <div class="setting-group">
        <div class="setting-label">Font Size</div>
        <div class="setting-control">
          <button class="setting-btn active" onclick="setFontSize(16)">Normal</button>
          <button class="setting-btn" onclick="setFontSize(18)">Large</button>
          <button class="setting-btn" onclick="setFontSize(14)">Small</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPING AREA -->
  <div class="typing-container" id="typingContainer">
    <div class="stats-bar">
      <div class="stat">
        <div class="stat-value" id="wpmDisplay">0</div>
        <div class="stat-label">WPM</div>
      </div>
      <div class="stat">
        <div class="stat-value" id="accuracyDisplay">100%</div>
        <div class="stat-label">Accuracy</div>
      </div>
      <div class="stat">
        <div class="stat-value" id="timeDisplay">0:00</div>
        <div class="stat-label">Time</div>
      </div>
      <div class="stat">
        <div class="stat-value" id="progressDisplay">0%</div>
        <div class="stat-label">Progress</div>
      </div>
    </div>

    <div class="progress-bar">
      <div class="progress-fill" id="progressBar" style="width: 0%"></div>
    </div>

    <div class="text-display" id="textDisplay"></div>

    <div class="input-area">
      <input type="text" class="input-field" id="inputField" placeholder="Start typing..."/>
    </div>

    <div class="controls">
      <button class="btn" id="pauseBtn" onclick="togglePause()">⏸ Pause</button>
      <button class="btn btn-secondary" onclick="resetTest()">🔄 Restart</button>
    </div>
  </div>

  <!-- RESULTS -->
  <div class="results-panel" id="resultsPanel">
    <h2 style="margin-bottom: 24px;">Results</h2>
    <div class="results-grid" id="resultsGrid"></div>
    <div id="chartsSection"></div>
    <div id="summarySection"></div>
    <button class="btn" onclick="resetTest()" style="width: 100%; margin-top: 24px;">Try Again</button>
  </div>

  <!-- HISTORY -->
  <div class="history-panel hidden" id="historyPanel">
    <h2 style="margin-bottom: 20px;">Session History</h2>
    <div class="history-list" id="historyList"></div>
    <button class="btn" style="width: 100%; margin-top: 20px;" onclick="clearHistory()">Clear History</button>
  </div>
</div>

<script>
// ============================================
// TYPING TEST PASSAGES
// ============================================
const passages = {
