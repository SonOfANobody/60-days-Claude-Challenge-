            <div style="font-size: 24px; font-weight: 700; color: var(--success);" id="thisMonthIncome">$0</div>
          </div>
          <div style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border);">
            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 4px;">Overdue Amount</div>
            <div style="font-size: 24px; font-weight: 700; color: var(--danger);" id="overdueAmount">$0</div>
          </div>
          <div>
            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 4px;">Days to Payment</div>
            <div style="font-size: 24px; font-weight: 700; color: var(--warning);" id="daysToPayment">0</div>
          </div>
        </div>
      </div>

      <h2 style="font-size: 18px; margin-bottom: 16px; color: var(--text-primary);">All Invoices</h2>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Client</th>
              <th>Description</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
              <th>Due</th>
              <th>Actions</th>
